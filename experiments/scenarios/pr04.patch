From 501e8698ffc41689eea729df2c52e8035fafbcd4 Mon Sep 17 00:00:00 2001
From: raquelxaviert <raquelxaviert@gmail.com>
Date: Wed, 18 Nov 2026 21:48:40 -0300
Subject: [PATCH] refactor(core): dispatch logs to reporters with forEach

AutoReviewer experimental scenario pr04.
---
 src/consola.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/consola.ts b/src/consola.ts
index baefd8f..163296b 100644
--- a/src/consola.ts
+++ b/src/consola.ts
@@ -449,11 +449,11 @@ export class Consola {
   }
 
   _log(logObj: LogObject) {
-    for (const reporter of this.options.reporters) {
+    this.options.reporters.forEach((reporter) => {
       reporter.log(logObj, {
         options: this.options,
       });
-    }
+    });
   }
 }
