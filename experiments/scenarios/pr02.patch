From 8ec739a9aa1c9c1984ee9ecabfbc13d2f86ecd64 Mon Sep 17 00:00:00 2001
From: raquelxaviert <raquelxaviert@gmail.com>
Date: Wed, 18 Nov 2026 21:48:39 -0300
Subject: [PATCH] refactor(tree): avoid joining tree chunks twice

AutoReviewer experimental scenario pr02.
---
 src/utils/tree.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/utils/tree.ts b/src/utils/tree.ts
index 17ad379..4440d0f 100644
--- a/src/utils/tree.ts
+++ b/src/utils/tree.ts
@@ -64,9 +64,9 @@ export function formatTree(items: TreeItem[], options?: TreeOptions): string {
     ...options,
   };
 
-  const tree = _buildTree(items, options).join("");
+  const tree = _buildTree(items, options);
   if (options && options.color) {
-    return colorize(options.color, tree);
+    return colorize(options.color, tree.join(""));
   }
 
   return tree;
