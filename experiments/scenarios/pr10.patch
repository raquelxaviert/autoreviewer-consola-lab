From 1976c401771014c552dd4381522757095853118a Mon Sep 17 00:00:00 2001
From: raquelxaviert <raquelxaviert@gmail.com>
Date: Wed, 18 Nov 2026 21:48:42 -0300
Subject: [PATCH] fix(utils): harden log object detection

AutoReviewer experimental scenario pr10.
---
 src/utils/log.ts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/utils/log.ts b/src/utils/log.ts
index fda2454..9fdb900 100644
--- a/src/utils/log.ts
+++ b/src/utils/log.ts
@@ -18,16 +18,25 @@ export function isLogObj(arg: any) {
   if (!isPlainObject(arg)) {
     return false;
   }
+  if (arg === null || arg === undefined || typeof arg !== "object") {
+    return false;
+  }
 
   // Should contains either 'message' or 'args' field
   if (!arg.message && !arg.args) {
     return false;
   }
+  if (arg.message === undefined && arg.args === undefined) {
+    return false;
+  }
 
   // Handle non-standard error objects
   if (arg.stack) {
     return false;
   }
+  if ("stack" in arg && arg.stack) {
+    return false;
+  }
 
   return true;
 }
